# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# App-specific ignores live in frontend/.gitignore

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Everything here is fetched or built at runtime, and large: the local ONNX
# embedding model (data/models, ~670 MB, downloaded on first embed) and the
# DuckDB file per attached dataset (data/datasets, one per user). Neither is
# this repo's to carry — see docs/22-no-local-corpus.md for what used to live
# here and why it does not any more.
data/*

# env files (can opt-in for committing if needed)
.env*
!.env.example
