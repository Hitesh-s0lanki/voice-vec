# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# App-specific ignores live in frontend/.gitignore

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# generated by scripts/ingest.py — the parquet cache (10 MB), the ONNX model
# (465 MB) and the Qdrant store (112 MB). All rebuildable; none belong in git.
# The manifest is small and describes the index, so it is kept.
data/*
!data/index-manifest.json

# env files (can opt-in for committing if needed)
.env*
!.env.example
