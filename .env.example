# Backend (FastAPI) — src/core/config.py
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=["http://localhost:3002"]

# ---- Voice (docs/11-voice.md) ---------------------------------------------
# Sarvam does the hearing (Saaras) and the speaking (Bulbul), and answers too
# when OpenAI is absent. One key is enough to hold a conversation.
SARVAM_API_KEY=

# Optional. With it set, OpenAI writes the replies and covers every language
# Bulbul cannot speak — French, Japanese, anything off the Indic list.
OPENAI_API_KEY=

# Override either half explicitly. Left empty they resolve from the keys above:
# OpenAI first, Sarvam second.
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_MODEL=sarvam-105b-conversations

# The voice. Speakers are model-specific — bulbul:v3 rejects bulbul:v2's names.
TTS_MODEL=bulbul:v3
TTS_SPEAKER=ritu

# There is no switch for retrieval. What gets searched is whatever the
# signed-in user connected — Pinecone, Astra, or their own Postgres
# (docs/13-connectors.md) — and this app holds no corpus of its own, so a
# listener with nothing attached is simply not retrieved for: their turns are
# answered by the model and by whatever tools they did connect. The settings
# below tune the pipeline for everyone who has attached something.

# ---- Postgres --------------------------------------------------------------
# This app's *own* database, and nothing is searched in it. What lives here:
#
#   conversations   saved turns, /c/{id}, docs/12-conversations.md
#   tool calls      what a spoken turn ran outside this app
#   connectors      the stores and services a user attached, credentials sealed
#   profiles        what was measured about each of those (docs/17-understanding.md)
#   datasets        what a pasted dataset URL turned into (docs/18-datasets.md)
#
# None of it is retrieval, so a DSN is worth setting even for a deployment
# nobody has attached a vector store to; without one the voice loop runs and
# simply does not remember anything. `uv run python -m scripts.migrate`
# creates every table and reports the round trip.
#
# There is no chunk table here. A question is answered from the vector store
# its asker connected, which this app reads and never writes.
#
# Neon, or locally:
#   docker run -d --name vec-pg -p 5432:5432 -e POSTGRES_PASSWORD=vec \
#     -e POSTGRES_DB=vec pgvector/pgvector:pg17
#
# On Neon use the *pooled* host (the one with `-pooler` in it). Keep the region
# the same as wherever the API runs: the round trip is spent inside the same
# 200 ms as extraction's 78 ms.
DATABASE_URL=postgresql://vec:vec@127.0.0.1:5432/vec
# HNSW search breadth, set on every connection this app opens — including the
# ones against a connected Postgres, which is where searches actually run.
# Raise for better recall, lower for latency. Never below SEARCH_LIMIT.
HNSW_EF_SEARCH=64

# Embedding (docs/25-no-local-embedder.md). `text-embedding-3`, over the network
# — there is no local model, because the ONNX session that used to be here held
# ~700 MiB resident. So OPENAI_API_KEY is what decides whether anything can be
# searched, reranked or grounded; without it the app still runs and still talks,
# it just cannot look anything up.
#
# The width is this app's own, for text it already holds. Nothing persists a
# vector of this app's making, so it is free to choose: 1536 is
# text-embedding-3-small native, and 512 or 768 move less over the wire per
# turn. A *connected store's* width is read from its own catalogue, never here.
EMBED_DIM=1536
# Queries only, and bounded — a question repeats between a turn's discovery and
# its search, and that is the one round trip worth not paying twice.
EMBED_CACHE_SIZE=256
# What one embedding call costs, for the stages that price themselves before
# running. Larger than DEADLINE_MS on purpose: inside a spoken turn the optional
# stages decline and say so rather than overrunning. Measure it from your region.
EMBED_CALL_MS=600

# Guardrails (docs/06-guardrails.md). Gate 2. The margin is the knob that moves:
# 0.010 answers more (coverage 0.75, catches 34% of unanswerable), 0.030 abstains
# more (coverage 0.29, catches 90%). Swept in docs/09-v1.md; re-sweep per index.
RETRIEVAL_FLOOR=0.845
RETRIEVAL_MARGIN=0.02

# Requirement 3's budget, in ms. The harness degrades rather than overrunning it.
DEADLINE_MS=200

# ---- The effort ladder (docs/15-effort.md) ---------------------------------
# The slider in the side panel picks a rung, and the rung picks an architecture:
#
#   0 lookup      search only — the passages, no model anywhere on the path
#   1 grounded    + a span lifted from a passage, + the answer cache
#   2 deep        + keyword/vector hybrid, rerank, one LLM synthesis
#   3 corrective  + relevance grading, query rewrite, one re-retrieval
#   4 adaptive    + routing before retrieval, and a capped repair loop
#
# It is a ceiling, not a floor: a cached question costs one embedding at rung 4.
# Lower this to cap what the deployment will spend regardless of the slider.
EFFORT_MAX=4
EFFORT_DEFAULT=2

# One budget per rung, in ms. Rungs 0-1 make no network call after the
# transcript arrives, which is what the 200 ms of requirement 3 is a claim
# about; the rest are measured against their own number rather than against one
# they were never going to meet. Reported as `budgetMs` on every answer.
EFFORT_DEADLINE_MS=[200,200,2500,9000,16000]

# ---- Answer cache (Redis) --------------------------------------------------
# Cache-augmented generation, rung 1 and up. A repeat question is answered from
# Redis at embedding cost alone — no search, no synthesis, no grading. At rung
# 3 or 4 that is the difference between six model calls and none.
#
#   docker run -d --name vec-redis -p 6379:6379 redis:8
#
# Two layers. Exact match works on any Redis. The semantic layer — which is the
# one that catches "what is a corporation" against "explain corporations" —
# needs the query engine: Redis 8, Redis Stack, or Redis Cloud. On a plain
# Redis it downgrades to exact-only and says so once in the log, and `/voice/ws`
# reports which one you got in `providers.cache`.
#
# Unset, the cache is simply off and every question runs the full pipeline.
REDIS_URL=

# How long an answer stays cached. Scoped per user and per backend, so a day
# is a bet on one person's connected store not changing under them — lower it
# if yours is written to continuously.
CACHE_TTL_S=86400

# How close a past question has to be to answer this one — cosine, on the same
# scale as RETRIEVAL_FLOOR above. Deliberately high: a loose cache threshold is
# a correctness bug that presents as a performance win, because the answer it
# serves to the wrong question still reads perfectly well. Sweep it before
# lowering it.
CACHE_SIMILARITY=0.97

# Redis sits on the answer path, so it gets a budget rather than a default
# socket timeout. A cache that has not answered in 150 ms already cost more
# than the search it was meant to save. Measured against a managed instance one
# region away, a warm round trip is ~6 ms.
CACHE_TIMEOUT_S=0.15

# *Opening* the connection is a different budget, and collapsing the two is a
# bug that only shows up against a remote Redis: a handshake across a region
# measured ~93 ms, so one shared 150 ms ceiling means the cache silently never
# connects at all.
CACHE_CONNECT_TIMEOUT_S=3.0

# How many answers one scope may hold. Measured with MEMORY USAGE against a
# managed Redis 8: one entry with a realistic Devanagari payload costs 6.09 KB,
# so a 30 MB instance holds roughly five thousand before index overhead. A
# single payload over CACHE_MAX_ENTRY_BYTES is skipped rather than cached, so
# one pathological passage cannot take a measurable share of a small database.
#
# Lowered from 1500 when agent memory moved into the same instance. Redis
# Cloud's Agent Memory service *attaches to a database* rather than
# provisioning its own, so on the free tier the cache and the agent's memories
# share these 30 MB — and `volatile-lru` cannot tell them apart, which means an
# unbounded cache does not fill up, it evicts the agent's memories. 900 entries
# is ~5.5 MB per scope. Raise it with the instance, not with the hit rate.
CACHE_MAX_ENTRIES=900
CACHE_MAX_ENTRY_BYTES=16384

# ---- Agent memory (docs/16-memory.md) ---------------------------------------
#
# Redis Agent Memory — the managed service, not a library:
# https://redis.io/docs/latest/operate/rc/context-engine/agent-memory/
#
# What it changes: turns are mirrored into *session memory* as they happen, the
# service extracts durable facts from them in the background, and the next
# conversation opens knowing what an earlier one established. Postgres remains
# the source of truth for transcripts — this stores what was *learned*, not
# what was said.
#
# Create the service in the Redis Cloud console (Agent Memory → New service).
# "Quick create" attaches it to the Free 30 MB database, which is the same one
# REDIS_URL above points at. Then copy these three from its Configuration tab;
# the API key is shown exactly once, at creation.
#
#   AGENT_MEMORY_ENDPOINT=https://<service>.agent-memory.redis.io
#   AGENT_MEMORY_STORE_ID=<store id>
#   AGENT_MEMORY_API_KEY=<service key>
#
# Any of the three unset and the agent simply keeps nothing between
# conversations. Everything else is unchanged — the same contract REDIS_URL
# has, and `/voice/ws` reports which one you got in `providers.memory`.
#
# Set the service's **Short-term TTL to 1-2 hours**, not the 1-day default.
# Session memory is a staging area for extraction here, not a store: the turns
# are already in Postgres, and on a 30 MB instance a day of retained transcripts
# is the difference between the cache working and the cache being evicted.
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=

# Keeps one deployment's memories out of another's when both point at the same
# store. Leave empty unless you set it everywhere: the service's positive
# namespace filters never match a record that has none, so a namespace set on
# reads but not on writes recalls nothing at all.
AGENT_MEMORY_NAMESPACE=

# Recall sits on the answer path, so it gets a budget rather than a default
# timeout — same reasoning as CACHE_TIMEOUT_S, larger because this round trip
# embeds the query and runs a KNN rather than reading a key. It runs
# concurrently with retrieval, so this is what it can *add*, not what it costs.
AGENT_MEMORY_TIMEOUT_MS=600

# How many facts may reach the prompt, and how close to the question they have
# to be. Both deliberately tight: these arrive ahead of the retrieved context
# and the question itself, and an irrelevant fact asserted as true about the
# listener in the model's opening sentence is the most damaging thing here to
# get wrong and the least likely to be caught by anything but a human ear.
AGENT_MEMORY_LIMIT=3
AGENT_MEMORY_SIMILARITY=0.62

# Every mirrored turn is trimmed to this before it is sent. The instance is the
# reason, not the request: an untrimmed monologue costs its full length in a
# 30 MB database for as long as its session lives, and adds nothing to
# extraction past the first couple of thousand characters.
AGENT_MEMORY_MAX_CHARS=2000

# Gate 4 (docs/06-guardrails.md). An extracted span is verified by substring;
# a *generated* answer cannot be, so every sentence of it is embedded and scored
# against the context it was written from. Local, so it costs milliseconds.
GENERATION_SUPPORT_FLOOR=0.62

# Every self-correction loop ships with a counter. This one spans the whole
# request — a query rewrite and a regeneration share the budget — because
# per-branch counters are how a repair loop ends up unbounded while each
# individual branch still looks capped.
MAX_REPAIRS=1

# ---- Clerk (src/core/clerk.py) --------------------------------------------
# Who a caller is when they are signed in. The browser opens the voice socket
# against this server directly, so identity arrives as a Clerk session token
# and is verified here — an id in a header is something anyone can type.
#
# The *publishable* key is enough and is not a secret: it already ships to
# every browser, and the instance host is base64'd into it, which is where the
# signing keys are fetched from. Same value as
# frontend/.env's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
#
# Unset, verification is off and every caller is anonymous — the voice loop is
# identical, conversations just belong to the browser rather than an account.
CLERK_PUBLISHABLE_KEY=pk_test_

# ---- Datasets (docs/18-datasets.md) -----------------------------------------
# A user attaches a dataset by URL (Hugging Face, or a direct parquet/CSV). A
# bounded prefix is pulled onto local disk, measured column by column, and
# queried in SQL through a sealed read-only DuckDB connection. Everything here
# has a working default; nothing needs setting to turn the feature on.
# DATASETS_ENABLED=true

# Rows pulled per table. A prefix, not a uniform sample — `LIMIT` on a parquet
# read stops at a row-group boundary, and sampling uniformly would mean
# downloading the whole file. Stated as a prefix everywhere it is served.
# DATASET_SAMPLE_ROWS=25000

# The dial that matters. A column whose projected download exceeds this is not
# materialised, and is named in the profile as unavailable rather than being
# silently absent. On MSMARCO-XI one column is 453 MB of a 470 MB file, and
# skipping it turned a 257 s pull into 30 s for four times the rows. Raise it
# when a wide column is the point of the dataset, then POST /datasets/{id}/rebuild.
# DATASET_COLUMN_BUDGET_MB=32

# Files taken from one source, and datasets one account may attach. Each costs
# disk and a block in every system prompt.
# DATASET_MAX_TABLES=12
# DATASET_MAX_PER_USER=10

# Whether a few sample rows may be sent to the model that names the dataset.
# Off keeps the profile to measurements, which still drives every line of the
# schema card and only costs the routing hints.
# DATASET_NARRATE=true

# ---- Composio (src/integrations/) ------------------------------------------
# Composio is the connector, and *the user* connects it. There is deliberately
# no COMPOSIO_API_KEY here: each signed-in account brings its own key from
# app.composio.dev, so a toolkit connected through this app lands in that
# person's Composio project rather than one belonging to whoever deployed it.
#
# That makes the key a real secret at rest, held per user_id, so it is
# encrypted before it reaches Postgres. This is the master key that encrypts
# them. Generate one with:
#
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Unset, nobody can connect Composio and the panel says so. Rotating it does
# not corrupt anything: every stored key simply stops decrypting and each user
# reconnects once. Never commit it — it is worth as much as the database.
COMPOSIO_ENCRYPTION_KEY=

# Every /integrations route requires a *verified* Clerk token, which makes
# CLERK_PUBLISHABLE_KEY above a prerequisite rather than an optional extra:
# without it nobody is ever signed in and every one of these routes 401s.

# Where Composio sends the browser back after consent. The *frontend* origin,
# not this server's: the page that reports the outcome is a Next route.
FRONTEND_URL=http://localhost:3002
