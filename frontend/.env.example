# The FastAPI voice backend — `uv run python -m src.main`.
#
# The browser opens this socket directly: a Next route handler speaks
# request/response, and a spoken turn is a two-way stream with an interrupt.
# No key is exposed by doing so — Sarvam and OpenAI are only ever called from
# the Python side, which is where SARVAM_API_KEY and OPENAI_API_KEY live (see
# ../.env.example).
#
# Leave it unset and the app assumes the backend is on port 8001 of whatever
# host the page came from.
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8001/voice/ws

# Only still used by the legacy /api/transcribe and /api/ask proxy routes.
SARVAM_API_KEY=
BACKEND_URL=http://127.0.0.1:8001

# The public origin this deployment answers on. It is what the canonical link
# and the Open Graph card's URLs are built from, so a shared link unfurls
# against the real host instead of somebody's laptop.
#
# Leave it unset and metadata resolves against http://localhost:3002, which is
# correct in development and wrong the moment a link leaves the machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
